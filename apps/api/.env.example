# ── Server ──
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (only needed when the web app
# calls the API cross-origin; the default setup proxies /api through Next.js).
CORS_ORIGINS=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://techbuddy:techbuddy@localhost:5432/techbuddy?schema=public

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Set to true behind HTTPS in production.
COOKIE_SECURE=false

# ── Uploads ──
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Seed (initial admin; required for `pnpm db:seed`) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Site Admin"
