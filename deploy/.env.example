# Production settings for deploy/compose.prod.yml. Copy to `.env` on the server and fill in.
# Never commit the real file.

# Public hostname. Point its DNS A/AAAA record at the server; Caddy fetches the certificate.
DOMAIN=techbuddy.example.com

# Database (URL-safe password: generate with `openssl rand -hex 24`).
POSTGRES_USER=techbuddy
POSTGRES_PASSWORD=
POSTGRES_DB=techbuddy

# Auth (generate with `openssl rand -hex 48`).
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Optional
# CORS_ORIGINS=           # only for browser clients on another origin; the apps don't need it
# ENABLE_SWAGGER=false
# MAX_UPLOAD_MB=10

# First admin account, used once by the seed command in deploy/README.md.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Site Admin
